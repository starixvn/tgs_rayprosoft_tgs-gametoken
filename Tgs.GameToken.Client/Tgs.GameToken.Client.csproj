<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<PropertyGroup>
		<Version>1.0.0</Version>
		<Authors>Raypro</Authors>
		<PackageProjectUrl>https://gitlab.com/rayprosoft/tgs-gametoken</PackageProjectUrl>
		<RepositoryUrl>https://gitlab.com/rayprosoft/tgs-gametoken.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<RootNamespace>Tgs.GameToken.Client</RootNamespace>
		<PackageId>Tgs.GameToken.Client</PackageId>
		<Title>Tgs.GameToken.Client</Title>
		<Description>Tgs.GameToken.Client</Description>
