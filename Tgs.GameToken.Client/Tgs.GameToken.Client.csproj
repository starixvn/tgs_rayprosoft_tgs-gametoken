<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net7.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<PropertyGroup>
		<Version>0.0.3</Version>
		<Authors>Raypro</Authors>
		<Description>Tgs GameToken Client</Description>
		<PackageProjectUrl>https://gitlab.com/rayprosoft/tgs-gametoken</PackageProjectUrl>
		<RepositoryUrl>https://gitlab.com/rayprosoft/tgs-gametoken.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>tgs-gametoken</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="Protos\**" />
		<EmbeddedResource Remove="Protos\**" />
		<None Remove="Protos\**" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="7.0.0" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="7.0.0" />
		<PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="17.6.40">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

</Project>
